# NéoMêtis Core — Hermes engine
HERMES_UPSTREAM=0
HERMES_MODEL_NAME=NousResearch/Hermes-3-Llama-3.1-8B
HERMES_API_BASE_URL=http://localhost:8080/v1
HERMES_API_KEY=

# Native tools
NEOMETIS_SPECS_ROOT=./workspace/specs
PENPOT_API_URL=http://localhost:6060
PLANE_API_URL=http://localhost:8001
PLANE_API_TOKEN=

# App
APP_PORT=8000
NEOMETIS_USE_RAG=false

# Chainlit auth (Option B — leave empty for local dev without auth)
CHAINLIT_AUTH_SECRET=
NEOMETIS_AUTH_USER=admin
NEOMETIS_AUTH_PASSWORD=

# Qdrant (local Docker: qdrant / 6333)
RAG_QDRANT_HOST=qdrant
RAG_QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=neometis_workspace

# Embeddings
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32

# CORS (optional — Next.js profile)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Remote / Traefik (profile: remote) ---
DOMAIN_NAME=neometis.local
ACME_EMAIL=admin@neomnia.net
TRAEFIK_ENABLE=false
TRAEFIK_BASIC_AUTH_MIDDLEWARE=
# Generate: htpasswd -nb admin password | sed -e 's/\\$/\\$\\$/g'
BASIC_AUTH_USERS=

# Legacy Next.js UI (profile: nextjs)
NEXT_PUBLIC_API_URL=http://localhost:8000
