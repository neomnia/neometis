# NéoMêtis Core — Hermes engine
HERMES_UPSTREAM=0
HERMES_MODEL_NAME=NousResearch/Hermes-3-Llama-3.1-8B
HERMES_API_BASE_URL=http://localhost:8080/v1
HERMES_API_KEY=

# Native tools
NEOMETIS_SPECS_ROOT=./workspace/specs
PENPOT_API_URL=http://localhost:6060
PLANE_API_URL=http://localhost:8001
PLANE_API_TOKEN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=neometis_workspace

# Embeddings (OpenAI-compatible /v1/embeddings)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
# Use EMBEDDING_PROVIDER=hash for local dev without an API key

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
